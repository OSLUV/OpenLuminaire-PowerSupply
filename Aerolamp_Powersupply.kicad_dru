(version 1)

(rule secondary_clearance
  (condition "A.NetClass == 'Sec' && B.NetClass != A.NetClass")
  (constraint clearance (min 8.0mm)))

(rule secondary_earth
  (condition "A.NetClass == 'Sec' && B.NetClass == 'EARTH'")
  (constraint clearance (min 8.0mm)))

(rule MainsPreFuse
  (condition "A.NetClass == 'MAINS_preFuse' && B.NetClass == 'MAINS_preFuse'")
  (constraint clearance (min 3.0mm)))

(rule PE
  (condition "A.NetClass == 'EARTH' && B.NetClass != A.NetClass")
  (constraint clearance (min 4.1mm)))

(rule secondary_earth
  (condition "A.NetClass == 'Sec' && B.NetClass == 'EARTH'")
  (constraint creepage (min 8.0mm)))
